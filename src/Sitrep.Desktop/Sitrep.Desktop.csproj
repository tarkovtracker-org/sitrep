<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Core\Sitrep.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Sitrep</AssemblyName>
    <RootNamespace>Sitrep.Desktop</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- app.ico is also the PE icon; the WPF copy feeds the tray entry (Shell_NotifyIcon needs an HICON at the window's DPI). -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo-64.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\notices\**\*" Link="notices\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Sitrep.Core\Data\PROVENANCE.md" Link="data\PROVENANCE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Sitrep.Core\Data\l81-apollyon.json" Link="data\l81-apollyon.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="tessdata\README.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Keep model-free compile possible; canonical verify/publish validates and packages the model. -->
    <None Include="tessdata\eng.traineddata" Condition="Exists('tessdata\eng.traineddata')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="IncludeRuntimeNotices" AfterTargets="ResolveFrameworkReferences" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_RuntimeNotice Include="%(ResolvedRuntimePack.PackageDirectory)\LICENSE*;%(ResolvedRuntimePack.PackageDirectory)\THIRD-PARTY-NOTICES*;%(ResolvedRuntimePack.PackageDirectory)\ThirdPartyNotices*"
                      Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App' Or '%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'">
        <Pack>%(ResolvedRuntimePack.NuGetPackageId)</Pack>
      </_RuntimeNotice>
      <_RuntimeLicense Include="@(_RuntimeNotice)" Condition="$([System.String]::Copy('%(Filename)').ToUpperInvariant().StartsWith('LICENSE'))" />
      <_RuntimeThirdParty Include="@(_RuntimeNotice)" Condition="$([System.String]::Copy('%(Filename)').ToUpperInvariant().Replace('-', '').StartsWith('THIRDPARTYNOTICES'))" />
      <Content Include="@(_RuntimeNotice)" Link="notices\runtime\%(_RuntimeNotice.Pack)\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Error Condition="'@(_RuntimeLicense)' == ''" Text="Missing required SDK runtime LICENSE notice in resolved runtime packs." />
    <Error Condition="'@(_RuntimeThirdParty)' == ''" Text="Missing required SDK runtime THIRD-PARTY-NOTICES in resolved runtime packs." />
  </Target>

  <Target Name="ValidatePublishedRuntimeNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_PublishedLicense Include="$(PublishDir)notices\runtime\**\*LICENSE*" />
      <_PublishedThirdParty Include="$(PublishDir)notices\runtime\**\*THIRD-PARTY-NOTICES*;$(PublishDir)notices\runtime\**\*ThirdPartyNotices*" />
    </ItemGroup>
    <Error Condition="'@(_PublishedLicense)' == ''" Text="Published output is missing required SDK runtime LICENSE file in notices\runtime." />
    <Error Condition="'@(_PublishedThirdParty)' == ''" Text="Published output is missing required SDK runtime THIRD-PARTY-NOTICES file in notices\runtime." />
  </Target>
</Project>
