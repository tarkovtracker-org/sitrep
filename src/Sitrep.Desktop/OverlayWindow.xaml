<Window x:Class="Sitrep.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SitrepOverlay" Width="380" SizeToContent="Height" MinHeight="100" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" ShowActivated="False"
        Background="Transparent" Foreground="White" IsHitTestVisible="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseDoubleClick="Window_MouseDoubleClick">
    <Border x:Name="OverlayCard" Margin="4" CornerRadius="8"
            Background="#9011151C" BorderBrush="#35FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Shown only while unlocked for repositioning. -->
            <Border x:Name="DragBanner" Grid.Row="0" Background="#DD0E4054" CornerRadius="7,7,0,0" Padding="8,5"
                    BorderThickness="0,0,0,1" BorderBrush="#4000C8FF" Visibility="Collapsed">
                <TextBlock Text="UNLOCKED  ·  DRAG TO MOVE  ·  DOUBLE-CLICK TO LOCK"
                           FontSize="10" FontWeight="Bold" Foreground="#FF00D2FF" HorizontalAlignment="Center"/>
            </Border>

            <Grid Grid.Row="1">
                <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        CornerRadius="2,0,0,2" Background="#FF4C8DFF" Margin="0,10"/>

                <StackPanel Margin="14,10,12,10">
                    <Grid>
                        <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FFF2F5F9" Text="SET MORTAR (CTRL+MMB)" TextTrimming="CharacterEllipsis"
                                   Margin="0,0,110,0"/>
                        <TextBlock x:Name="ProfileText" HorizontalAlignment="Right" FontSize="10"
                                   Foreground="#FFA0AAB8" Text="L81 · uncorrected table"/>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock x:Name="ElevationValue" FontFamily="Consolas" FontSize="36" LineHeight="38"
                                       LineStackingStrategy="BlockLineHeight"
                                       FontWeight="Bold" Text="—" Foreground="#FFFFFFFF"/>
                            <TextBlock Text="MIL" FontSize="12" Foreground="#FFA0AAB8"
                                       Margin="6,0,0,6" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock x:Name="RangeValue" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" Foreground="#FFE0E8F0" Text="—"/>
                            <TextBlock x:Name="BearingValue" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" Foreground="#FFE0E8F0" Text="—"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="#20FFFFFF" Margin="0,8,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OriginText" Grid.Column="0" FontFamily="Consolas" FontSize="11"
                                   Foreground="#FFAEBCC9" Text="ORG  —"/>
                        <TextBlock x:Name="TargetText" Grid.Column="1" FontFamily="Consolas" FontSize="11"
                                   Foreground="#FFAEBCC9" Text="TGT  —"/>
                    </Grid>

                    <Border Height="1" Background="#15FFFFFF" Margin="0,6,0,5"/>
                    <TextBlock FontSize="10" Foreground="#FF788B9E" HorizontalAlignment="Center"
                               Text="Ctrl + MMB  Origin     ·     Shift + MMB  Target"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
